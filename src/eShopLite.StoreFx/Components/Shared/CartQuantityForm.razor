@inject IStoreService StoreService
@inject ICartService CartService
@inject NavigationManager Navigation

@* Render inside a FormMappingScope unique to the cart line. *@
<form method="post" @formname="update-quantity" @onsubmit="Update" data-enhance
      class="d-flex gap-2 justify-content-center align-items-center">
    <label class="visually-hidden" for="@InputId">Quantity for @Item.Name</label>
    <input type="number" id="@InputId" name="Quantity" value="@Item.Quantity" min="1"
           class="form-control form-control-sm qty-input" />
    <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
</form>

@code {
    [Parameter, EditorRequired] public CartItem Item { get; set; }

    [SupplyParameterFromForm] private int? Quantity { get; set; }

    private string InputId => $"cart-qty-{Item.ProductId}";

    private void Update()
    {
        var product = StoreService.GetProduct(Item.ProductId);
        if (product == null)
        {
            Navigation.NotFound();
            return;
        }

        var cart = CartService.GetCart();
        cart.SetQuantity(Item.ProductId, Quantity ?? Item.Quantity);
        CartService.Save(cart);

        Navigation.NavigateTo("/Cart");
    }
}
